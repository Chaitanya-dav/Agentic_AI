# Application Configuration
APP_NAME="Agentic AI Secure Approval & Execution System"
APP_ENV=development
DEBUG=true

# Database Configuration
DATABASE_URL=sqlite:///./secure_execution.db

# Cryptographic Security
SECRET_KEY=super-secret-cryptographic-signing-key-2026
APPROVAL_EXPIRY_SECONDS=3600

# LLM Provider Configuration
# Set USE_MOCK_LLM=true to run completely offline without an external API key.
USE_MOCK_LLM=true
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
